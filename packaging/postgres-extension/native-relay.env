# Set a long, randomly generated secret before starting the service.
TRELLARA_NATIVE_RELAY_SECRET=
TRELLARA_NATIVE_RELAY_SOCKET=/run/trellara/native-relay.sock
TRELLARA_NATIVE_RELAY_SPOOL=/var/lib/trellara/native-relay.spool
# Set to kafka to require broker durability before PostgreSQL acknowledgement.
TRELLARA_NATIVE_RELAY_DURABILITY=spool
TRELLARA_KAFKA_BOOTSTRAP_SERVERS=
TRELLARA_KAFKA_CLIENT_ID=trellara-native-relay
TRELLARA_KAFKA_MESSAGE_TIMEOUT_MS=30000
TRELLARA_KAFKA_PROOF_PATH=/var/lib/trellara/native-relay.kafka-proof
